<div class="planner">
  <div class="panel">
    <h1>人に会う</h1>
    <div class="inline-time-row">会う日時は <input class="time-input" id="rendezvous-time" type="time"></div>
    <div class="inline-time-row">
      電車を調べる &nbsp;
      <input type="checkbox" id="train-check">
      <label for="train-check"></label>
    </div>
    <div class="inline-time-row">家を出る時間 <input class="time-input" id="departure-time" type="time"></div>
    <div class="inline-time-row">準備開始時刻 = <span class="time-preview" id="prepare-start-time">??:??</span></div>
    <div class="inline-time-row">
      カレンダーに入れる &nbsp;
      <input type="checkbox" id="calendar-check">
      <label for="calendar-check"></label>
    </div>
  </div>

  <div class="panel">
    <h2>当日</h2>
    合計時間：<span id="total-time">??分</span><br>
    <ul class="task-list">
      <% [
        ["電車の運行を再確認する", 5],
        ["服を選んで着る", 5],
        ["歯みがき", 3],
        ["髭を剃る", 1],
        ["持ち物を確認する", 5]
      ].each do |title, minutes| %>
        <li class="task" data-minutes="<%= minutes %>">
          <label><input type="checkbox"> <%= title %></label>
          <span class="task-duration"><%= minutes %>分</span>
          <div class="task-meta"></div>
        </li>
      <% end %>
    </ul>
    <div class="inline-time-row">
      家を出る時間 <span class="time-preview" id="departure-time-last">??:??</span>
      (あと <span id="time-to-departure">??分</span>)
    </div>
  </div>
</div>

<script type="module">
const tasks = [...document.querySelectorAll('.task')];
const departureInput = document.getElementById('departure-time');

departureInput.addEventListener('input', render);
tasks.forEach(task => task.addEventListener('change', render));
render();

function parseTime(value) {
  if (!value) return null;
  const [h, m] = value.split(':').map(Number);
  return h * 60 + m;
}

function toTimeText(totalMinutes) {
  const n = ((totalMinutes % 1440) + 1440) % 1440;
  return `${String(Math.floor(n / 60)).padStart(2, '0')}:${String(n % 60).padStart(2, '0')}`;
}

function fmtSignedMin(m) {
  return `${m}分`;
}

function remainingMinutes(task) {
  return task.querySelector('input').checked ? 0 : Number(task.dataset.minutes);
}

function render() {
  const now = new Date();
  const nowMin = now.getHours() * 60 + now.getMinutes();
  const depMin = parseTime(departureInput.value);
  let cumulative = 0;

  tasks.forEach(task => {
    const done = task.querySelector('input').checked;
    const startMin = nowMin + cumulative;
    const minsToDep = depMin == null ? null : depMin - startMin;
    const meta = task.querySelector('.task-meta');
    meta.textContent = done
      ? '完了'
      : `予想開始 ${toTimeText(startMin)}${minsToDep == null ? '' : ` / 出発まであと ${fmtSignedMin(minsToDep)}`}`;
    meta.classList.toggle('alert', !done && minsToDep != null && minsToDep < 0);
    cumulative += remainingMinutes(task);
  });

  document.getElementById('total-time').textContent = `${cumulative}分`;
  document.getElementById('prepare-start-time').textContent = depMin == null ? '??:??' : toTimeText(depMin - cumulative);
  document.getElementById('departure-time-last').textContent = departureInput.value || '??:??';

  const toDeparture = document.getElementById('time-to-departure');
  const remaining = depMin == null ? null : depMin - nowMin;
  toDeparture.textContent = remaining == null ? '??分' : fmtSignedMin(remaining);
  toDeparture.classList.toggle('alert', remaining != null && remaining < 0);
}
</script>
