<div class="planner">
  <div class="panel">
    <h1>入浴</h1>
    <p class="subtle">紅茶でもいれる / 冷めないようにする</p>
  </div>
  <div class="panel">
    <ul class="task-list">
      <% [
        ["シャワーを浴びる", 20],
        ["保湿をする", 2],
        ["髪を乾かす", 3],
        ["新しい下着を着る", 2],
        ["脱いだ服を片付ける", 1]
      ].each do |title, minutes| %>
        <li class="task">
          <label><input type="checkbox"> <%= title %></label>
          <span class="task-duration"><%= minutes %>分</span>
        </li>
      <% end %>
    </ul>
  </div>
</div>
