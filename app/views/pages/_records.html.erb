<style>
  .record.selected {
    filter: brightness(0.8);
  }

  .selection-summary {
    display: none;
    margin: 10px 0;
    padding: 10px;
    background-color: #f0f0f0;
    border-radius: 4px;
    font-size: 14px;
  }
</style>

<div data-controller="record-selection">
  <% if page.records.any? %>
    <%= render "pages/category_durations", page: page %>

    <div class="selection-summary" data-record-selection-target="summary">
      選択: <strong data-record-selection-target="total">0:00</strong>
      <button type="button" data-action="click->record-selection#reset">リセット</button>
    </div>

    <table>
      <thead>
        <tr>
          <th><input type="checkbox" style="visibility: hidden;"></th>
          <th>Start</th>
          <th>Duration</th>
          <th>What</th>
          <th>Category</th>
        </tr>
      </thead>
      <tbody>
        <% last_record = page.records.last %>
        <% page.records.each do |record| %>
          <% cap_height = record == last_record && record.category == "睡眠" %>
          <%= render partial: "record_row", locals: { record: record, categories: @categories, cap_height: cap_height } %>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>