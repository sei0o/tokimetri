<tr data-log-target="row" style="background-color: <%= hex_to_pastel(@categories[form.object.category]) %>">
  <td class="time">
    <%= form.text_field :start_time, value: extended_time(form.object.start_time, @page.date), class: "start" %>
  </td>
  <td class="time">
    <%= form.text_field :end_time, value: extended_time(form.object.end_time, @page.date), class: "end" %>
  </td>
  <td class="duration"><%= minutes_to_hm(form.object.duration_minutes) if form.object.duration_minutes %></td>
  <td><%= form.text_field :what, data: { action: "change->log#guessCategory" } %></td>
  <td>
    <%= form.select :category, categories, { include_blank: true }, { data: { action: "change->log#colorize input->log#accept" } } %>
  </td>
  <td class="destroy">
    <%= form.check_box :_destroy %>
    <%= form.hidden_field :kind, value: "activity" %>
    <%= form.hidden_field :id if form.object.persisted? %>
  </td>
</tr>
