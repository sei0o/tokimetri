<style>
  .record {
    vertical-align: top;
  }

  .record td {
    padding: 5px;
  }

  .record {
    cursor: pointer;
  }

</style>

<tr class="record" style="height: <%= cap_height ? '6rem' : "#{[1, 1 + (record.duration_minutes || 0 - 20) / 20.0].max}rem" %>; background-color: <%= hex_to_pastel(categories[record.category]) %>;" data-action="click->record-selection#toggleRow">
  <td>
    <input type="checkbox" name="record_ids[]" value="<%= record.id %>" form="assign"
           data-record-selection-target="checkbox" 
           data-action="change->record-selection#toggle"
           data-duration="<%= record.duration_minutes || 0 %>">
  </td>
  <td><%= record.start_time&.strftime("%H:%M") %></td>
  <td>
    <% if record.duration_minutes %>
      <%= minutes_to_hm(record.duration_minutes) %>
    <% else %>
      ?
    <% end %>
  </td>
  <td><%= record.what %></td>
  <td><%= record.category %></td>
</tr>
