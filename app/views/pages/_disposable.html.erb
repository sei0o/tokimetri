<% if @date == current_date %>
  <p>
    残り可処分 <%= disposable_formula(@disposable.left_parts) %>
    / 今日 <%= minutes_to_hm(@disposable.on(@date)) %>
  </p>
<% elsif @date > current_date %>
  <p>可処分 予定 <%= disposable_formula(@disposable.parts(@date)) %></p>
<% elsif @page.recorded? %>
  <p>可処分 実際 <%= disposable_formula(DisposableTime.actual(@page)) %></p>
<% end %>
